# Gerado em /etc/nginx/conf.d/default.conf pelo envsubst do entrypoint.
# Variáveis: API_UPSTREAM (ex.: http://api:8080), NGINX_RESOLVER (DNS do Docker) e a chave opcional da Esri (ver "Visão de satélite" abaixo).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Uploads do DocIA passam pelo proxy.
    client_max_body_size 25m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Resolução em tempo de requisição: o Nginx sobe mesmo se a API ainda não existir.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Proxy da API: o navegador só fala com este host (sem CORS).
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Visão de satélite (Esri World Imagery, ArcGIS Location Platform). A chave fica só aqui, no servidor:
    # o navegador pede /tiles/esri/{z}/{y}/{x} e o Nginx acrescenta a chave. Sem cache local das imagens
    # (termos de uso da Esri). A chave vem do .env pelo compose; vazia ou não definida (o envsubst deixa o
    # texto literal) não passa no formato abaixo: as rotas respondem 404 e o botão fica desabilitado.
    set $esri_key "${ESRI_API_KEY}";

    location = /tiles/esri/status {
        access_log off;
        if ($esri_key !~ "^[A-Za-z0-9._~-]{20,}$") { return 404; }
        return 204;
    }

    # Capturas nomeadas: o "if" com regex abaixo sobrescreveria $1..$3.
    location ~ ^/tiles/esri/(?<esri_z>\d+)/(?<esri_y>\d+)/(?<esri_x>\d+)$ {
        # A URL do upstream contém a chave: log de erro só em nível crítico para não registrá-la.
        error_log /dev/stderr crit;
        if ($esri_key !~ "^[A-Za-z0-9._~-]{20,}$") { return 404; }
        proxy_pass https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/$esri_z/$esri_y/$esri_x?token=$esri_key;
        proxy_ssl_server_name on;
        proxy_set_header Host ibasemaps-api.arcgis.com;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_http_version 1.1;
        proxy_read_timeout 20s;
        proxy_hide_header Set-Cookie;
    }

    # Arquivos com hash do Vite: cache longo.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # Fallback SPA: rotas internas (ex.: /flux/demandas) servem o index.html.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
