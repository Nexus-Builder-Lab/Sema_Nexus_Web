# SEMA NEXUS Web — variáveis de ambiente (EXEMPLO)
# Copie para .env.local. Variáveis VITE_* ficam PÚBLICAS no bundle: nunca coloque segredos aqui.

# true = usa os mocks MSW gerados do contrato OpenAPI (sem precisar da API)
VITE_USE_MOCKS=false

# Destino do proxy /api no servidor de desenvolvimento do Vite
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Habilita a camada opcional de tiles OpenStreetMap no mapa (requer internet)
VITE_MAP_ONLINE_TILES=false
