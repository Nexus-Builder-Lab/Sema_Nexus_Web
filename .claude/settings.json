{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard origin*)",
      "Bash(git filter-branch:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh api *collaborators*)",
      "Bash(gh api *invitations*)",
      "Bash(gh api *members*)",
      "Bash(gh api *memberships*)",
      "Bash(gh api *permission*)",
      "Bash(gh api *visibility*)",
      "Bash(gh api *teams*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf C:*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker-compose down -v*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",
      "PowerShell(docker compose down -v*)",
      "PowerShell(docker volume rm*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh repo edit*)",
      "Read(./.env)",
      "Read(./.env.*.local)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git tag:*)",
      "Bash(git push --tags:*)",
      "Bash(gh release create:*)",
      "Bash(git push origin main:*)",
      "Bash(scripts/demo-reset*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(git tag*)",
      "PowerShell(*demo-reset*)"
    ]
  }
}
